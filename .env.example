# ThresholdVault local configuration for scripts/dev.sh
#
#   cp .env.example .env     # then edit .env
#
# .env is git-ignored: put real RPC URLs and API keys there, never here.
# Variables set on the command line override values in .env, e.g.
#   SEPOLIA_RPC_URL=https://... scripts/dev.sh

# --- Blockchain RPC endpoints (testnets only) --------------------------------
# Required for balances, prepare and broadcast on that chain. Leave empty to
# disable live features for the chain (addresses still work).
# Free endpoints: Alchemy or Infura (create an app on "Ethereum Sepolia").
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=

# --- Tokens (development defaults) -------------------------------------------
# Bearer token for the REST API (what Postman / curl send).
API_TOKEN=dev-api-token
# Token the coordinator uses to call the signers.
SIGNER_TOKEN=dev-signer-token
# User-only token for the user signer's approval API. The coordinator never
# gets this one; it is what makes approvals the user's decision.
APPROVAL_TOKEN=dev-approval-token

# --- Ports and data ----------------------------------------------------------
API_PORT=8080
APPROVAL_PORT=7101
# Wallet database, encrypted key shares and signer identities.
DATA=./data/dev
